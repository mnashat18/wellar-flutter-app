# Directus runtime environment template.
# Placeholder values only. Do not put real production secrets in this file.

PUBLIC_URL=https://dash.conntinuity.com

# Core Directus secrets
KEY=replace-with-random-key
SECRET=replace-with-random-secret

# Database
DB_CLIENT=pg
DB_HOST=replace-with-db-host
DB_PORT=5432
DB_DATABASE=replace-with-db-name
DB_USER=replace-with-db-user
DB_PASSWORD=replace-with-db-password

# Admin bootstrap only. Do not use real credentials here.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-admin-password

# CORS/security
CORS_ENABLED=true
CORS_ORIGIN=https://replace-with-allowed-origin.example
REFRESH_TOKEN_COOKIE_SECURE=true
REFRESH_TOKEN_COOKIE_SAME_SITE=lax

# Files/storage
STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads

# Email
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=replace-with-smtp-host
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=replace-with-smtp-user
EMAIL_SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM=no-reply@example.com

# Google mobile exchange extension
GOOGLE_MOBILE_ALLOWED_CLIENT_IDS=replace-with-google-oauth-client-id
GOOGLE_MOBILE_ALLOW_USER_CREATE=false
GOOGLE_MOBILE_DEFAULT_ROLE_ID=replace-with-directus-role-id-or-empty

# Optional OAuth/provider settings
AUTH_PROVIDERS=
AUTH_GOOGLE_CLIENT_ID=replace-with-google-client-id
AUTH_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

